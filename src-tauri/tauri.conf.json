{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trellis",
  "version": "0.2.1",
  "identifier": "com.tarasbondaruk.trellis",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": { "resources/gamification_demo.sqlite": "gamification_demo.sqlite" },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
