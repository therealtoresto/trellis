{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trellis",
  "version": "0.5.0",
  "identifier": "com.tarasbondaruk.trellis",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": { "resources/gamification_demo.sqlite": "gamification_demo.sqlite" },
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxQ0Y1MDlEMkY1QzZGMzcKUldRM2Ixd3ZuVkRQNFRNZmxyUW8xbVVWWUxXRjkrSjhSQTZGVjVGcHA2V3pSckJGdTJHcTZvc1gK",
      "endpoints": ["https://github.com/therealtoresto/trellis/releases/latest/download/latest.json"]
    }
  }
}
